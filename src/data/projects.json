      "/assets/images/crp_ikyhwm4_2025.png"
    ]
  },
  {
    "id": "distributed-dissonance-2025",
    "title": "Distributed Dissonance",
    "role": "An immersive audiovisual installation by philterSoup and MYLES that transforms audience smartphones into a collaborative drone orchestra. Participants scan a QR code to instantly join a shared Wi-Fi network, enabling intuitive, interactive control of their phone-generated sounds. Their collective interactions merge seamlessly into a live, evolving composition, driving synchronized surround-sound and dynamic visuals. In a captivating 5–10 minute experience, Distributed Dissonance explores digital interconnectedness and collective creativity, turning personal devices into powerful instruments of artistic collaboration and expression.",
    "composer": "",
    "year": "2025",
    "image": "/assets/images/crp_dd1_2025.png",
